{
  "npm.packageManager": "pnpm",
  "typescript.tsdk": "node_modules/typescript/lib",
  "tailwindCSS.experimental.configFile": {
    "src/assets/css/style.css": [
      "!src/assets/css/payload.css",
      "src/app/(frontend)/**/*",
      "src/assets/css/**/*",
      "!src/assets/css/payload.css",
      "src/components/**/*"
    ],
    "src/assets/css/payload.css": [
      "src/assets/css/payload.css",
      "src/app/(payload)/**/*"
    ]
  }
}
